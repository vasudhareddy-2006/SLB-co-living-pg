# ==========================================
# SLB Coliving PG — Backend Environment Config
# ==========================================

# 1. Supabase PostgreSQL Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI or Session mode)
# Example: postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.example:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for migrations if using connection pooler:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.example.supabase.co:5432/postgres"

# 2. Supabase API Credentials (optional for direct Supabase SDK integration)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Security & JWT Settings
JWT_SECRET_KEY="change-this-to-a-secure-random-32-char-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Default Seed Admin Credentials (created on startup if no admin exists)
ADMIN_DEFAULT_EMAIL="admin@slbcoliving.com"
ADMIN_DEFAULT_PASSWORD="admin123"
ADMIN_DEFAULT_NAME="SLB Admin"

# 5. Server Settings
PORT=8000
HOST="0.0.0.0"
DEBUG=True
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:5500,http://localhost:5500"
